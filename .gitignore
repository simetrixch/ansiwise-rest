# Resolved, not authored.
.dart_tool/

# The lock. This package is a LIBRARY — nothing here is compiled to anything, so the versions it
# happened to resolve against are no part of what ships, and what a build resolves is the pin in the
# application that consumes it. Tracked it would carry the opposite of a pin: every `dart pub get`
# rewrites it, and a resolution beside a sibling checkout writes that machine's directory layout into
# the file everyone gets.
pubspec.lock

# The path override that points at the sibling checkouts beside this one. Whoever has them writes
# their own; the git dependencies in pubspec.yaml are what everyone else resolves. Tracked, it would
# hand every clone a set of paths that are not there.
pubspec_overrides.yaml

# Build output.
build/

# Agent instructions. Loaded from disk by whichever harness opens this repository, and never
# tracked: they are ours, and this repository is meant to be cloned and used by anybody.
CLAUDE.md
AGENTS.md
